generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  displayName  String
  email        String?
  avatarUrl    String?
  ssoUserId    String?  @unique
  ssoPublicId  Int?
  isRoot       Boolean @default(false)
  sessions     UserSession[]
  guestbook    Guestbook[]
  comments     Comment[]
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  summary     String
  content     String
  cover       String?
  status      String    @default("draft") // draft | published
  viewCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tags        Tag[]
  comments    Comment[]
  likes       Like[]
  views       PostView[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  nickname  String
  content   String
  avatarUrl String?
  email     String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Like {
  id          Int      @id @default(autoincrement())
  postId      Int
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([postId, fingerprint])
}

model Guestbook {
  id        Int      @id @default(autoincrement())
  nickname  String
  content   String
  avatarUrl String?
  email     String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model FriendLink {
  id          Int    @id @default(autoincrement())
  name        String
  url         String
  avatar      String?
  description String?
  sort        Int    @default(0)
}

model Project {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  url          String?
  techStack    String?
  cover        String?
  sort         Int      @default(0)
  source       String   @default("manual") // manual | github
  githubId     String?  @unique
  fullName     String?
  stars        Int      @default(0)
  homepage     String?
  customTitle  String?  // 替换显示名称
  customSummary String? // 替换简介
  customHtml   String?  // 卡片 Markdown 内容
  bgImage      String?  // 详情页背景图
  showInNav    Boolean  @default(true)
  hidden       Boolean  @default(false) // 前台是否隐藏
  indexed      Boolean  @default(true)  // 是否参与搜索索引
  navOrder     Int      @default(0)
  gitSourceId  Int?
  gitSource    GitSource? @relation(fields: [gitSourceId], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model ProxyProfile {
  id        Int     @id @default(autoincrement())
  name      String
  host      String
  port      Int
  username  String?
  password  String?
  protocol  String  @default("http") // http | socks5
  enabled   Boolean @default(true)
}

model DnsProfile {
  id       Int     @id @default(autoincrement())
  name     String
  servers  String  // 逗号分隔 DNS IP
  enabled  Boolean @default(true)
}

model PostView {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  fingerprint String
  createdAt DateTime @default(now())

  @@unique([postId, fingerprint])
}

model GitSource {
  id           Int       @id @default(autoincrement())
  kind         String    // user | org
  name         String    // GitHub login
  enabled      Boolean   @default(true)
  autoSync     Boolean   @default(false)
  hiddenNew    Boolean   @default(false) // 新同步项目默认是否隐藏
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  projects     Project[]

  @@unique([name, kind])
}

model NavItem {
  id        Int     @id @default(autoincrement())
  label     String
  href      String
  sort      Int     @default(0)
  visible   Boolean @default(true)
  isSystem  Boolean @default(false)
}

model ProxyAllowHost {
  id        Int    @id @default(autoincrement())
  host      String @unique
  note      String?
}

model ToolAuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // dns | proxy
  target    String
  actor     String?
  ok        Boolean
  detail    String?
  createdAt DateTime @default(now())
}

model GalleryItem {
  id          Int    @id @default(autoincrement())
  title       String
  imageUrl    String
  description String?
  sort        Int    @default(0)
  hidden      Boolean @default(false)
}

model About {
  id      Int    @id @default(1)
  title   String
  content String
}

model SiteSetting {
  id          Int    @id @default(1)
  heroKicker  String @default("YUEYUEDAO TECH")
  heroTitle   String @default("在清透的风与\n墨绿的电路之间")
  heroSubtitle String @default("记录代码、二次元与生活的小站。欢迎留言、交换友链。")
  heroImage   String @default("/assets/hero.png")
  siteName    String @default("月月岛")
  footerNote  String @default("以清透的风写代码与梦")
  aboutTitle  String @default("关于月月岛")
  commentRequireSso Boolean @default(true)
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("local") // local | sso
  createdAt    DateTime @default(now())
}
